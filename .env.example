# Core Django/runtime
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
FABINZI_PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://fabinzi:fabinzi@localhost:5432/fabinzi
REDIS_URL=redis://localhost:6379/0
INTEGRATION_ENCRYPTION_KEY=
DEFAULT_LANGUAGE=en
TIME_ZONE=Africa/Cairo
API_ANON_RATE=120/hour
API_USER_RATE=1200/hour

# Optional Sentry bootstrap. Other integrations are configured in /Maneg/.
SENTRY_ENABLED=false
SENTRY_DSN=

# Manual QA demo seed. The command refuses to run unless this is true.
FABINZI_DEMO_SEED_ENABLED=false
DEMO_ADMIN_EMAIL=demo.admin@fabinzi.example
DEMO_ADMIN_PASSWORD=
DEMO_DESIGNER_EMAIL=demo.designer@fabinzi.example
DEMO_DESIGNER_PASSWORD=
DEMO_MANUFACTURER_EMAIL=demo.manufacturer@fabinzi.example
DEMO_MANUFACTURER_PASSWORD=
DEMO_CUSTOMER_EMAIL=demo.customer@fabinzi.example
DEMO_CUSTOMER_PASSWORD=
