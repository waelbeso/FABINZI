{
  "openapi": "3.1.0",
  "info": {
    "title": "FABINZI Customer API v1",
    "version": "1.0.0",
    "description": "Frozen first-party Customer mobile contract under /api/v1/customer/. Designer, Manufacturer, /Maneg/, finance, operations, moderation and payment-webhook families are excluded."
  },
  "servers": [{"url": "/", "description": "Same-origin API; production requires HTTPS."}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/api/v1/customer/bootstrap/": {"get": {"operationId": "customerBootstrap", "security": [], "responses": {"200": {"$ref": "#/components/responses/Ok"}}}},
    "/api/v1/customer/auth/login/": {"post": {"operationId": "customerLogin", "security": [], "requestBody": {"$ref": "#/components/requestBodies/Login"}, "responses": {"200": {"$ref": "#/components/responses/TokenPair"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/auth/refresh/": {"post": {"operationId": "customerRefresh", "security": [], "requestBody": {"$ref": "#/components/requestBodies/Refresh"}, "responses": {"200": {"$ref": "#/components/responses/TokenPair"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/auth/logout/": {"post": {"operationId": "customerLogout", "requestBody": {"$ref": "#/components/requestBodies/Refresh"}, "responses": {"204": {"description": "Presented refresh token revoked; access token expires naturally."}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/me/": {
      "get": {"operationId": "customerMe", "responses": {"200": {"$ref": "#/components/responses/Identity"}, "401": {"$ref": "#/components/responses/Error"}}},
      "patch": {"operationId": "customerMeUpdate", "requestBody": {"$ref": "#/components/requestBodies/PreferencePatch"}, "responses": {"200": {"$ref": "#/components/responses/Identity"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/customer/stores/": {"get": {"operationId": "customerStores", "security": [], "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PageSize"}, {"name": "q", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"$ref": "#/components/responses/Page"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/stores/{store_slug}/": {"get": {"operationId": "customerStoreDetail", "security": [], "parameters": [{"$ref": "#/components/parameters/StoreSlug"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/products/": {"get": {"operationId": "customerProducts", "security": [], "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PageSize"}, {"name": "q", "in": "query", "schema": {"type": "string"}}, {"name": "store", "in": "query", "schema": {"type": "string"}}, {"name": "customizable", "in": "query", "schema": {"type": "boolean"}}], "responses": {"200": {"$ref": "#/components/responses/Page"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/stores/{store_slug}/products/{product_slug}/": {"get": {"operationId": "customerProductDetail", "security": [], "parameters": [{"$ref": "#/components/parameters/StoreSlug"}, {"$ref": "#/components/parameters/ProductSlug"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/artworks/": {"get": {"operationId": "customerArtworks", "security": [], "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PageSize"}, {"name": "q", "in": "query", "schema": {"type": "string"}}, {"name": "method", "in": "query", "schema": {"type": "string", "enum": ["print", "embroidery"]}}], "responses": {"200": {"$ref": "#/components/responses/Page"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/artworks/{artwork_id}/": {"get": {"operationId": "customerArtworkDetail", "security": [], "parameters": [{"$ref": "#/components/parameters/ArtworkId"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/studio-projects/": {
      "get": {"operationId": "customerStudioProjects", "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PageSize"}], "responses": {"200": {"$ref": "#/components/responses/Page"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "customerStudioCreate", "requestBody": {"$ref": "#/components/requestBodies/StudioCreate"}, "responses": {"201": {"$ref": "#/components/responses/Studio"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/customer/studio-projects/{project_id}/": {
      "get": {"operationId": "customerStudioDetail", "parameters": [{"$ref": "#/components/parameters/ProjectId"}], "responses": {"200": {"$ref": "#/components/responses/Studio"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "patch": {"operationId": "customerStudioUpdate", "parameters": [{"$ref": "#/components/parameters/ProjectId"}], "requestBody": {"$ref": "#/components/requestBodies/StudioPatch"}, "responses": {"200": {"$ref": "#/components/responses/Studio"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/customer/studio-projects/{project_id}/customization/": {"post": {"operationId": "customerStudioCustomization", "parameters": [{"$ref": "#/components/parameters/ProjectId"}], "responses": {"201": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/studio-projects/{project_id}/uploads/": {"post": {"operationId": "customerStudioUpload", "parameters": [{"$ref": "#/components/parameters/ProjectId"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["file"], "properties": {"file": {"type": "string", "format": "binary", "description": "PNG, JPEG or WebP; maximum 10 MiB / 10485760 bytes."}}}}}}, "responses": {"201": {"$ref": "#/components/responses/Upload"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "415": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/studio-projects/{project_id}/elements/": {"post": {"operationId": "customerStudioElementCreate", "parameters": [{"$ref": "#/components/parameters/ProjectId"}], "requestBody": {"$ref": "#/components/requestBodies/ElementCreate"}, "responses": {"201": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/studio-projects/{project_id}/elements/{element_id}/": {
      "patch": {"operationId": "customerStudioElementUpdate", "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/ElementId"}], "requestBody": {"$ref": "#/components/requestBodies/ElementPatch"}, "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "delete": {"operationId": "customerStudioElementDelete", "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/ElementId"}], "responses": {"204": {"description": "Element deleted."}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/customer/studio-projects/{project_id}/validation/": {"get": {"operationId": "customerStudioValidate", "parameters": [{"$ref": "#/components/parameters/ProjectId"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/studio-projects/{project_id}/ready/": {"post": {"operationId": "customerStudioReady", "parameters": [{"$ref": "#/components/parameters/ProjectId"}], "responses": {"200": {"$ref": "#/components/responses/Studio"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/studio-projects/{project_id}/checkout/": {"post": {"operationId": "customerStudioCheckout", "parameters": [{"$ref": "#/components/parameters/ProjectId"}], "responses": {"201": {"$ref": "#/components/responses/Checkout"}, "200": {"$ref": "#/components/responses/Checkout"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/media/{asset_id}/": {"get": {"operationId": "customerPrivateMedia", "parameters": [{"$ref": "#/components/parameters/AssetId"}], "responses": {"200": {"description": "Authorized private image bytes in local/test storage."}, "302": {"description": "Authorized redirect to a short-lived signed S3 GET URL; current expiry 300 seconds."}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/cart/": {"get": {"operationId": "customerCart", "responses": {"200": {"$ref": "#/components/responses/Cart"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/cart/items/": {"post": {"operationId": "customerCartItemCreate", "requestBody": {"$ref": "#/components/requestBodies/CartItemCreate"}, "responses": {"201": {"$ref": "#/components/responses/Cart"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/cart/items/{item_id}/": {
      "patch": {"operationId": "customerCartItemUpdate", "parameters": [{"$ref": "#/components/parameters/ItemId"}], "requestBody": {"$ref": "#/components/requestBodies/CartItemPatch"}, "responses": {"200": {"$ref": "#/components/responses/Cart"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "delete": {"operationId": "customerCartItemDelete", "parameters": [{"$ref": "#/components/parameters/ItemId"}], "responses": {"204": {"description": "Cart item deleted."}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/customer/cart/checkout/": {"post": {"operationId": "customerCartCheckout", "responses": {"201": {"$ref": "#/components/responses/Checkout"}, "200": {"$ref": "#/components/responses/Checkout"}, "401": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/checkouts/{checkout_id}/": {
      "get": {"operationId": "customerCheckoutDetail", "parameters": [{"$ref": "#/components/parameters/CheckoutId"}], "responses": {"200": {"$ref": "#/components/responses/Checkout"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "patch": {"operationId": "customerCheckoutUpdate", "parameters": [{"$ref": "#/components/parameters/CheckoutId"}], "requestBody": {"$ref": "#/components/requestBodies/ShippingPatch"}, "responses": {"200": {"$ref": "#/components/responses/Checkout"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/customer/checkouts/{checkout_id}/place/": {"post": {"operationId": "customerCheckoutPlace", "parameters": [{"$ref": "#/components/parameters/CheckoutId"}, {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 80, "pattern": "^[A-Za-z0-9._:-]{8,80}$"}}], "requestBody": {"$ref": "#/components/requestBodies/Place"}, "responses": {"201": {"$ref": "#/components/responses/Placement"}, "200": {"$ref": "#/components/responses/Placement"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/payment-options/": {"get": {"operationId": "customerPaymentOptions", "responses": {"200": {"$ref": "#/components/responses/Ok"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/purchases/": {"get": {"operationId": "customerPurchases", "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PageSize"}], "responses": {"200": {"$ref": "#/components/responses/Page"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/purchases/{purchase_reference}/": {"get": {"operationId": "customerPurchaseDetail", "parameters": [{"$ref": "#/components/parameters/PurchaseReference"}], "responses": {"200": {"$ref": "#/components/responses/Purchase"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/notifications/": {"get": {"operationId": "customerNotifications", "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PageSize"}], "responses": {"200": {"$ref": "#/components/responses/Page"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/notifications/preferences/": {
      "get": {"operationId": "customerNotificationPreferences", "responses": {"200": {"$ref": "#/components/responses/NotificationPreferences"}, "401": {"$ref": "#/components/responses/Error"}}},
      "patch": {"operationId": "customerNotificationPreferencesUpdate", "requestBody": {"$ref": "#/components/requestBodies/NotificationPreferences"}, "responses": {"200": {"$ref": "#/components/responses/NotificationPreferences"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/customer/notifications/read-all/": {"post": {"operationId": "customerNotificationsReadAll", "responses": {"200": {"$ref": "#/components/responses/Ok"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/customer/notifications/{notification_id}/read/": {"post": {"operationId": "customerNotificationRead", "parameters": [{"$ref": "#/components/parameters/NotificationId"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "15-minute access JWT; 30-day rotating refresh with blacklist/revocation."}},
    "parameters": {
      "Page": {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1}},
      "PageSize": {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}, "description": "Default 20; maximum 50."},
      "StoreSlug": {"name": "store_slug", "in": "path", "required": true, "schema": {"type": "string"}},
      "ProductSlug": {"name": "product_slug", "in": "path", "required": true, "schema": {"type": "string"}},
      "ArtworkId": {"name": "artwork_id", "in": "path", "required": true, "schema": {"type": "integer"}},
      "ProjectId": {"name": "project_id", "in": "path", "required": true, "schema": {"type": "integer"}},
      "ElementId": {"name": "element_id", "in": "path", "required": true, "schema": {"type": "integer"}},
      "AssetId": {"name": "asset_id", "in": "path", "required": true, "schema": {"type": "integer"}},
      "ItemId": {"name": "item_id", "in": "path", "required": true, "schema": {"type": "integer"}},
      "CheckoutId": {"name": "checkout_id", "in": "path", "required": true, "schema": {"type": "integer"}},
      "PurchaseReference": {"name": "purchase_reference", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "NotificationId": {"name": "notification_id", "in": "path", "required": true, "schema": {"type": "integer"}}
    },
    "requestBodies": {
      "Login": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "writeOnly": true}}}}}},
      "Refresh": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["refresh"], "properties": {"refresh": {"type": "string", "writeOnly": true}}}}}},
      "PreferencePatch": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"language": {"type": "string", "enum": ["en", "ar"]}, "theme": {"type": "string", "enum": ["system", "light", "dark"]}}}}}},
      "StudioCreate": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["store_slug", "product_slug"], "properties": {"store_slug": {"type": "string"}, "product_slug": {"type": "string"}, "variant_sku": {"type": ["string", "null"]}, "quantity": {"type": "integer", "minimum": 1}, "customer_notes": {"type": "string"}}}}}},
      "StudioPatch": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"variant_sku": {"type": ["string", "null"]}, "quantity": {"type": "integer", "minimum": 1}, "customer_notes": {"type": "string"}}}}}},
      "ElementCreate": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["kind", "decoration_zone", "transform", "rights_confirmed"], "properties": {"kind": {"type": "string", "enum": ["text", "image", "artwork"]}, "decoration_zone": {"type": "string"}, "text": {"type": "string"}, "media_asset_id": {"type": "integer"}, "artwork_version_id": {"type": "integer"}, "production_method": {"type": "string", "enum": ["", "print", "embroidery"]}, "rights_confirmed": {"type": "boolean"}, "transform": {"type": "object"}, "style": {"type": "object"}, "sort_order": {"type": "integer", "minimum": 0}}}}}},
      "ElementPatch": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"transform": {"type": "object"}, "production_method": {"type": "string", "enum": ["print", "embroidery"]}, "text": {"type": "string"}}}}}},
      "CartItemCreate": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "enum": ["plain", "ready_designed", "studio"]}, "store_slug": {"type": "string"}, "product_slug": {"type": "string"}, "variant_sku": {"type": "string"}, "studio_project_id": {"type": "integer"}, "quantity": {"type": "integer", "minimum": 1}}}}}},
      "CartItemPatch": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["quantity"], "properties": {"quantity": {"type": "integer", "minimum": 1}}}}}},
      "ShippingPatch": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"shipping_name": {"type": "string"}, "shipping_phone": {"type": "string"}, "shipping_email": {"type": "string"}, "shipping_address1": {"type": "string"}, "shipping_address2": {"type": "string"}, "shipping_city": {"type": "string"}, "shipping_region": {"type": "string"}, "shipping_country": {"type": "string"}, "postal_code": {"type": "string"}}}}}},
      "Place": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["payment_method"], "properties": {"payment_method": {"type": "string", "enum": ["cod", "paymob", "stripe"]}}}}}},
      "NotificationPreferences": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"email_enabled": {"type": "boolean"}, "sms_enabled": {"type": "boolean"}, "phone_e164": {"type": "string"}}}}}}
    },
    "responses": {
      "Ok": {"description": "Success", "content": {"application/json": {"schema": {"type": "object"}}}},
      "Page": {"description": "Paginated success", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Page"}}}},
      "Identity": {"description": "Customer identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomerIdentity"}}}},
      "TokenPair": {"description": "Bearer token pair", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPair"}}}},
      "Studio": {"description": "Persisted Studio project", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StudioProject"}}}},
      "Upload": {"description": "Private upload metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PrivateUpload"}}}},
      "Cart": {"description": "Authoritative Cart", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Cart"}}}},
      "Checkout": {"description": "Authoritative Checkout", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Checkout"}}}},
      "Placement": {"description": "Canonical parent Purchase placement/replay", "content": {"application/json": {"schema": {"type": "object", "required": ["idempotent_replay", "purchase", "payment"], "properties": {"idempotent_replay": {"type": "boolean"}, "purchase": {"$ref": "#/components/schemas/Purchase"}, "payment": {"type": "object"}}}}}},
      "Purchase": {"description": "Canonical parent Purchase", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Purchase"}}}},
      "NotificationPreferences": {"description": "Notification preferences", "content": {"application/json": {"schema": {"type": "object", "required": ["email_enabled", "sms_enabled", "phone_e164"], "properties": {"email_enabled": {"type": "boolean"}, "sms_enabled": {"type": "boolean"}, "phone_e164": {"type": "string"}}}}}},
      "Error": {"description": "Standard Customer API error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    },
    "schemas": {
      "ErrorEnvelope": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "fields", "request_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "fields": {"type": "object"}, "request_id": {"type": "string"}}}}},
      "Page": {"type": "object", "additionalProperties": false, "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "items": {"type": "object"}}}},
      "Money": {"type": "object", "additionalProperties": false, "required": ["amount", "currency"], "properties": {"amount": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"}, "currency": {"type": ["string", "null"]}}},
      "TokenPair": {"type": "object", "additionalProperties": false, "required": ["token_type", "access", "refresh", "access_expires_in", "refresh_expires_in"], "properties": {"token_type": {"const": "Bearer"}, "access": {"type": "string", "writeOnly": true}, "refresh": {"type": ["string", "null"], "writeOnly": true}, "access_expires_in": {"const": 900}, "refresh_expires_in": {"const": 2592000}}},
      "CustomerIdentity": {"type": "object", "additionalProperties": false, "required": ["id", "username", "display_name", "first_name", "last_name", "email", "language", "theme", "account_state"], "properties": {"id": {"type": "integer"}, "username": {"type": "string"}, "display_name": {"type": "string"}, "first_name": {"type": "string"}, "last_name": {"type": "string"}, "email": {"type": "string"}, "language": {"type": "string", "enum": ["en", "ar"]}, "theme": {"type": "string", "enum": ["system", "light", "dark"]}, "account_state": {"const": "active"}}},
      "StudioProject": {"type": "object", "required": ["id", "status", "product", "variant", "quantity", "customer_notes", "unit_price", "decoration_zones", "elements", "created_at", "updated_at", "ready_at"], "properties": {"id": {"type": "integer"}, "status": {"type": "string", "enum": ["draft", "ready", "archived"]}, "product": {"type": "object"}, "variant": {"type": ["object", "null"]}, "quantity": {"type": "integer", "minimum": 1}, "customer_notes": {"type": "string"}, "unit_price": {"$ref": "#/components/schemas/Money"}, "decoration_zones": {"type": "array", "items": {"type": "object"}}, "elements": {"type": "array", "items": {"type": "object"}}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "ready_at": {"type": ["string", "null"], "format": "date-time"}}},
